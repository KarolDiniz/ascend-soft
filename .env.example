# Supabase (ranking global gratuito)
# Crie um projeto em https://supabase.com (plano Free)
# SQL Editor → cole supabase/schema.sql → Run
# Settings → API → Project URL + chave publishable (anon public)
# URL: só o domínio, SEM /rest/v1/ no final
# Nunca use sb_secret_... no front-end (só publishable/anon)

VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...ou_eyJ...anon
